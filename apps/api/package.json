{
  "name": "@spaceops/api",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "dev": "tsx watch src/main.ts",
    "build": "tsc -p tsconfig.json",
    "start": "node dist/main.js",
    "typecheck": "tsc --noEmit",
    "db:migrate": "tsx src/database/cli.ts migrate",
    "db:seed": "tsx src/database/cli.ts seed",
    "test": "jest --runInBand --testPathIgnorePatterns=integration",
    "test:integration": "jest --runInBand --testMatch=\"**/*.integration.spec.ts\""
  },
  "dependencies": {
    "@nestjs/common": "11.2.10",
    "@nestjs/core": "11.2.10",
    "@nestjs/platform-express": "11.2.10",
    "@nestjs/swagger": "11.4.8",
    "argon2": "0.44.0",
    "cookie-parser": "1.4.7",
    "dotenv": "17.4.2",
    "express-rate-limit": "8.7.4",
    "helmet": "8.3.0",
    "luxon": "3.7.2",
    "pg": "8.23.1",
    "reflect-metadata": "0.2.2",
    "rxjs": "7.8.2",
    "typeorm": "0.3.31",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@types/cookie-parser": "1.4.10",
    "@types/express": "5.0.6",
    "@types/jest": "29.5.14",
    "@types/luxon": "3.7.6",
    "@types/node": "22.20.5",
    "@types/pg": "8.23.1",
    "@types/supertest": "6.0.3",
    "jest": "29.7.0",
    "supertest": "7.3.2",
    "ts-jest": "29.4.15",
    "tsx": "4.23.15",
    "typescript": "5.9.3"
  }
}
