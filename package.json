{
  "name": "spaceops",
  "version": "1.0.0",
  "private": true,
  "workspaces": [
    "apps/api",
    "apps/web"
  ],
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev": "concurrently -n api,web -c blue,green \"npm run dev -w apps/api\" \"npm run dev -w apps/web\"",
    "build": "npm run build --workspaces",
    "typecheck": "npm run typecheck --workspaces && npm run typecheck:e2e",
    "test": "npm run test --workspaces",
    "test:integration": "npm run test:integration -w apps/api",
    "test:e2e": "playwright test",
    "db:migrate": "npm run db:migrate -w apps/api",
    "db:seed": "npm run db:seed -w apps/api",
    "check": "npm run typecheck && npm test && npm run build",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "typecheck:e2e": "tsc -p tsconfig.e2e.json",
    "test:smoke": "node scripts/smoke-production.cjs"
  },
  "devDependencies": {
    "@playwright/test": "1.65.0",
    "concurrently": "9.2.5",
    "prettier": "3.10.1"
  }
}
